{
  "name": "teacher-workbench",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run server\" \"npm run web\"",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "web": "vite",
    "build": "vite build",
    "build:mobile": "vite build --mode mobile",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "apk": "npm run build:mobile && npx cap sync android && cd android && ./gradlew assembleDebug",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
